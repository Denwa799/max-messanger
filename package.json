{
  "name": "max-messanger",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings -c oxlintrc.json",
    "lint:fix": "oxlint --fix -c oxlintrc.json",
    "lint:fsd": "steiger ./src",
    "format": "prettier -w ./src",
    "format:check": "prettier -c ./src",
    "clean": "rm -rf dist .output .tanstack",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run format:check && npm run lint && npm run lint:fsd && npm run typecheck",
    "prepare-push": "npm run format && npm run lint && npm run lint:fsd && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix -c oxlintrc.json",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@maxhub/max-ui": "^0.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "axios": "^1.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "steiger": "^0.6.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
